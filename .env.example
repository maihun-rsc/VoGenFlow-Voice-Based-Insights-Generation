# ==============================================================================
# Vo-Gen-Flow 2.0 Environment Configuration Template
# ==============================================================================
# Copy this file to .env and populate with your credentials.
# NEVER commit raw API keys or production secrets to source control.
# ==============================================================================

# --- Groq Cloud LPU Engine ---
# Required for live cloud speech-to-text (Whisper) and council multi-agent deliberation.
# Obtain your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Default high-capability LLM for Council PM, Architect, Systems, UI, Agile, and Diff seats
DEFAULT_GROQ_LLM_MODEL=openai/gpt-oss-120b

# --- Local LM Studio Bionic Bridge (Optional / Zero-Cloud Air-Gapped Mode) ---
# Connects to local LM Studio daemon running on host machine for offline LLM & vector embeddings.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=text-embedding-nomic-embed-text-v1.5

# --- FastAPI REST & WebSocket Gateway ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Runtime Operational Flags ---
# Set to 1 to force offline simulation mode (uses curated engineering templates with 0 network calls)
VOGENFLOW_OFFLINE_MODE=0

# Set to 1 to bypass trial quota limitations for automated testing or internal enterprise deployments
VOGENFLOW_DISABLE_QUOTA=0
